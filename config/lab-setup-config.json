                "TEXMFLOCAL C:/texlive/texmf-local",
                "TEXMFSYSCONFIG C:/texlive/2025/texmf-config",
                "TEXMFSYSVAR C:/texlive/2025/texmf-var",
                "TEXMFVAR C:/texlive/texmf-var",
                "binary_win32 1",
